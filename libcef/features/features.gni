declare_args() {
  enable_cef = true
  cef_enable_printing = true
  cef_enable_pdf = true
  cef_enable_webrtc = true
  # Build the CEF Media Router API and its browser-side integration.
  cef_enable_media_router = true
  # Keep Cast/DIAL provider activation independent from the CEF API.
  cef_enable_cast = true
  # Build optional CEF media-capture and audio-loopback integration.
  cef_enable_media_capture = true
  cef_enable_audio_loopback = true
  # Build CEF file-dialog integration and platform dialog runners.
  cef_enable_file_dialogs = true
  # Build CEF JavaScript dialog integration and platform dialog runners.
  cef_enable_javascript_dialogs = true
  # Build CEF download callbacks and download item wrappers.
  cef_enable_downloads = true
  # Build Blink Shape Detection API bindings and the corresponding service.
  cef_enable_shape_detection = true
  # Keep Blink SVG sources and bindings in the build. Set to false only for a
  # dedicated downstream experiment; SVG is referenced by HTML, CSS and
  # generated bindings and therefore requires a follow-up Blink patch.
  cef_enable_blink_svg = true
  # Keep the Blink animation engine in the build. Set to false only for a
  # dedicated downstream experiment; CSS transitions and Web Animations share
  # this target and its generated bindings.
  cef_enable_blink_animation = true
  # Keep the optional ui/gfx keyframe animation target dependency exported by
  # Blink. Geometry and Skia dependencies remain mandatory.
  cef_enable_gfx_animation = true

  # Enables base target customizations necessary for distribution of the
  # cef_sandbox static library. This value will be set via gn_args.py for the
  # official sandbox build configurations only. DO NOT SET THIS VALUE MANUALLY
  # FOR OTHER CHROMIUM/CEF BUILD CONFIGURATIONS AS ITS USE MAY HAVE SIGNIFICANT
  # PERFORMANCE AND/OR SECURITY IMPLICATIONS.
  is_cef_sandbox_build = false
}
